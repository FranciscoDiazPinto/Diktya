# Aplicación
APP_NAME=Netbot
ENVIRONMENT=development

# PostgreSQL local (coincide con docker-compose.yml)
POSTGRES_DB=netbot
POSTGRES_USER=netbot
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://netbot:change-me@localhost:5432/netbot

# Integraciones: configurar solo en el entorno local, nunca guardar credenciales reales aquí
OPNSENSE_BASE_URL=
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
# Verificación TLS (recomendado). Si OPNsense usa certificado propio, indique su CA en lugar de desactivar.
OPNSENSE_VERIFY_TLS=true
OPNSENSE_CA_BUNDLE=
OPNSENSE_TIMEOUT_SECONDS=5
OPNSENSE_CONNECT_TIMEOUT_SECONDS=3
# Proveedor DHCP de OPNsense: dnsmasq | kea
OPNSENSE_DHCP_BACKEND=dnsmasq
# Zona IANA del firewall: su log de pf entrega hora local sin zona.
OPNSENSE_TIMEZONE=UTC

# UniFi Network: API oficial, solo lectura, con API key generada en la consola.
# Sin UNIFI_BASE_URL y UNIFI_API_KEY la fuente figura como no configurada.
UNIFI_ENABLED=true
# direct = contra la consola | connector = vía Site Manager (requiere WAN)
UNIFI_TRANSPORT=direct
UNIFI_BASE_URL=
UNIFI_CONSOLE_ID=
UNIFI_API_KEY=
# UUID o internalReference del sitio. Opcional si la consola tiene un solo sitio.
UNIFI_SITE=
UNIFI_VERIFY_TLS=true
UNIFI_CA_BUNDLE=
UNIFI_TIMEOUT_SECONDS=10
UNIFI_CONNECT_TIMEOUT_SECONDS=3

# OpenRouter (solo backend; no guardar una clave real en Git)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_SECONDS=20

# Monitoreo (Épica 002)
# opnsense = API real (por defecto) | mock = datos inventados, solo para demostración
# Sin OPNSENSE_* la fuente figura como no configurada; nunca recurre al mock.
MONITORING_PROVIDER=opnsense
# Solo con MONITORING_PROVIDER=mock: healthy | degraded | outage
MONITORING_MOCK_SCENARIO=healthy
# Segundos que se reutiliza una lectura antes de volver a consultar al firewall (0 = sin caché)
MONITORING_CACHE_TTL_SECONDS=5
FIREWALL_LOG_FETCH_LIMIT=500
# Muestreo de tráfico para el gráfico del dashboard (historial en memoria)
MONITORING_SAMPLE_INTERVAL_SECONDS=5
MONITORING_HISTORY_SECONDS=3600
# Inventario, alertas y disponibilidad persistidos
MONITORING_COLLECTOR_ENABLED=true
MONITORING_INVENTORY_INTERVAL_SECONDS=30
# Pasado este tiempo sin lectura válida, el dato se marca como desactualizado
MONITORING_INVENTORY_MAX_AGE_SECONDS=60
# Tope de la espera progresiva entre reintentos de una fuente caída
MONITORING_RETRY_MAX_SECONDS=300
# Fallos seguidos antes de alertar la pérdida de una fuente
MONITORING_SOURCE_FAILURE_THRESHOLD=2
MONITORING_AVAILABILITY_WINDOW_HOURS=24
MONITORING_PLAN_MAX_BYTES=5242880

# Tickets y notificaciones (Épica 005)
TICKET_AGENT_ENABLED=true
TICKET_AGENT_INTERVAL_SECONDS=15
# Reglas propias de criticidad, por tipo de incidente. Vacío = reglas por defecto.
# Ejemplo: {"device_offline":"critica"}. Ver docs/soporte-cliente.md
TICKET_CRITICALITY_RULES_JSON=
# Dispositivos afectados a la vez desde los que se sube un nivel de criticidad
TICKET_MASS_INCIDENT_DEVICES=3
# Minutos máximos sin atención. Vacío = {"critica":15,"alta":30,"media":120,"baja":480}
TICKET_ATTENTION_MINUTES_JSON=
NOTIFICATION_EMAIL_MAX_ATTEMPTS=5
NOTIFICATION_EMAIL_RETRY_SECONDS=60
# Base del enlace incluido en las notificaciones
PUBLIC_APP_URL=http://localhost:5173
# Correo: sin SMTP_HOST solo se notifica dentro de la aplicación
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Autenticación
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Soporte por red: debe coincidir exactamente con Network.site de esta instancia.
MONITORING_SITE_ID=
NETWORK_STATUS_MAX_AGE_SECONDS=60
# JSON de referencias de acceso Wi-Fi (SecretStr, solo backend). Configurar en el entorno
# de despliegue o gestor de secretos. Nunca guardar claves reales en este archivo.
# Formato y vinculación: docs/soporte-cliente.md
WIFI_ACCESS_CREDENTIALS_JSON=

# Carga CSV: validación y reservas locales, sin ejecución UniFi
CSV_MAX_BYTES=1048576
CSV_MAX_ROWS=500
CSV_PREVIEW_TTL_SECONDS=900
CSV_INVENTORY_MAX_AGE_SECONDS=60

# IDs de redes ABIERTAS cuyo QR sera PUBLICO (portal de invitados).
# Vacio por defecto. Las redes WPA de cliente requieren un destinatario registrado.
# Configuracion de las referencias de acceso: docs/atencion-invitados.md
GUEST_WIFI_NETWORK_IDS=[]
