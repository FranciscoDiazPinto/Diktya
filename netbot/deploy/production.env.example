# Variables de un despliegue de producción (docker-compose.prod.yml).
# Copiar a netbot/.env, completar y proteger con permisos 600. Nunca versionar el resultado.
# El detalle de cada variable opcional está en .env.example.

ENVIRONMENT=production
# Nombre DNS con el que los usuarios abren Netbot; debe coincidir con el certificado.
NETBOT_SERVER_NAME=netbot.example.internal
PUBLIC_APP_URL=https://netbot.example.internal
CORS_ORIGINS=https://netbot.example.internal

# PostgreSQL. Contraseñas distintas y URL-safe: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=netbot
POSTGRES_USER=netbot_owner
POSTGRES_PASSWORD=
NETBOT_APP_PASSWORD=

# Firma de sesiones: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# Primer administrador (solo se crea si el correo no existe). Mínimo 12 caracteres;
# cambiarla desde «Mi cuenta» tras el primer ingreso y luego vaciar estas dos variables.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Monitoreo (solo lectura). HTTPS obligatorio; CA interna mediante *_CA_BUNDLE, nunca VERIFY_TLS=false.
MONITORING_PROVIDER=opnsense
MONITORING_SITE_ID=
OPNSENSE_BASE_URL=
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
OPNSENSE_CA_BUNDLE=
OPNSENSE_TIMEZONE=America/Santiago
UNIFI_ENABLED=true
UNIFI_BASE_URL=
UNIFI_API_KEY=
UNIFI_SITE=
UNIFI_CA_BUNDLE=

# Asistente: openrouter | anthropic. La clave vive solo en el backend.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Correo (tickets y recuperación Wi-Fi). STARTTLS obligatorio hacia servidores remotos.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
NOTIFICATION_EMAIL_ENABLED=true
GUEST_EMAIL_RECOVERY_ENABLED=false
GUEST_EMAIL_RECOVERY_PUBLIC_URL=https://netbot.example.internal

# Cambios sobre la red: deshabilitados hasta validar en laboratorio la versión del controlador.
# Para habilitarlos: inventario real, contrato confirmado, UNIFI_WRITE_ENABLED=true, la clave de
# escritura en .env.worker (UNIFI_WRITE_API_KEY=...) y `docker compose --profile worker up -d`.
UNIFI_INVENTORY_MODE=disabled
UNIFI_API_BASE_URL=
UNIFI_API_CONTRACT=
UNIFI_WRITE_ENABLED=false
SSID_SECURITY_PROFILES_JSON=
WIFI_ACCESS_CREDENTIALS_JSON=
GUEST_WIFI_NETWORK_IDS=[]
