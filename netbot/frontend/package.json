{
  "name": "netbot-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "npm run test:controllers && npm run test:react",
    "test:controllers": "node --test tests/*.test.mjs",
    "test:react": "vitest run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
